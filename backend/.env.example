# =============================================================================
# Configuration RythmoAI Backend (§6.1 CDC)
# Copier ce fichier en .env et adapter selon l'environnement
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (§9.1, §18.4)
# -----------------------------------------------------------------------------
# Option 1: URL complète (recommandé pour la production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rythmoai

# Option 2: Composants individuels (utilisés si DATABASE_URL n'est pas défini)
DB_ENGINE=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rythmoai

# -----------------------------------------------------------------------------
# Tests unitaires
# -----------------------------------------------------------------------------
# URL SQLite asynchrone pour les tests (ne pas modifier sauf besoin spécifique)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# -----------------------------------------------------------------------------
# Sécurité (§15.4, §15.7)
# -----------------------------------------------------------------------------
# Clé secrète JWT - GÉNÉRER UNE NOUVELLE CLÉ POUR LA PRODUCTION
# Exemple: openssl rand -hex 32
SECRET_KEY=r3ythm0a1-super-secret-key-32bytes-long!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Redis (§10.1 Cache & Sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Stockage S3 / MinIO (§12.2 Assets média)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=rythmoai-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# -----------------------------------------------------------------------------
# Feature flags (§19.3 Déploiement progressif)
# -----------------------------------------------------------------------------
# Synchronisation labiale (§8.2.6, §11.4)
FEATURE_LIP_SYNC=false
LIP_SYNC_FPS=10
LIP_SYNC_CONFIDENCE_THRESHOLD=0.5

# CRDT pour édition collaborative (§16.4)
FEATURE_CRDT=false

# Séparation de sources (§12.1)
# Valeurs: auto | spectral | demucs | off
SOURCE_SEPARATION_BACKEND=auto
FEATURE_SOURCE_SEPARATION=false
